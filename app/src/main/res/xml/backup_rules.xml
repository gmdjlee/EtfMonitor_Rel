<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for EtfMonitor (Android 11 and below)
    See https://developer.android.com/guide/topics/data/autobackup
    Note: This file is ignored for devices API 31+
    See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Include general app preferences -->
    <include domain="sharedpref" path="." />

    <!-- SECURITY: Exclude encrypted API key storage -->
    <exclude domain="sharedpref" path="ai_api_prefs.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />

    <!-- Include database for user convenience on restore -->
    <include domain="database" path="etf_db" />

    <!-- Exclude database journals -->
    <exclude domain="database" path="etf_db-journal" />
    <exclude domain="database" path="etf_db-shm" />
    <exclude domain="database" path="etf_db-wal" />
</full-backup-content>
