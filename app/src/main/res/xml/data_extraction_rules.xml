<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for EtfMonitor (Android 12+)
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes

    Note: MasterKey keyset (__androidx_security_crypto_master_key_keyset__)
    is stored in "file" domain which is NOT included below, so it's
    automatically excluded from backup/transfer. No explicit exclude needed.
-->
<data-extraction-rules>
    <!-- Cloud Backup Rules (Google Drive backup) -->
    <cloud-backup>
        <!-- Include general app preferences -->
        <include domain="sharedpref" path="." />

        <!-- SECURITY: Exclude encrypted API key storage from cloud backup -->
        <exclude domain="sharedpref" path="ai_api_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />

        <!-- Include database for user convenience -->
        <include domain="database" path="etf_monitor.db" />

        <!-- Exclude database journals -->
        <exclude domain="database" path="etf_monitor.db-journal" />
        <exclude domain="database" path="etf_monitor.db-shm" />
        <exclude domain="database" path="etf_monitor.db-wal" />
    </cloud-backup>

    <!-- Device-to-Device Transfer Rules -->
    <device-transfer>
        <!-- Include general app preferences -->
        <include domain="sharedpref" path="." />

        <!-- SECURITY: Exclude sensitive data even on device transfer -->
        <exclude domain="sharedpref" path="ai_api_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />

        <!-- Include database -->
        <include domain="database" path="etf_monitor.db" />

        <!-- Exclude database journals -->
        <exclude domain="database" path="etf_monitor.db-journal" />
        <exclude domain="database" path="etf_monitor.db-shm" />
        <exclude domain="database" path="etf_monitor.db-wal" />
    </device-transfer>
</data-extraction-rules>
